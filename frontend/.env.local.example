# ── Copy this file to .env.local and fill in your values ──

# Public site URL (used to resolve Open Graph/Twitter share images)
# Dev:  http://localhost:3000
# Prod: https://your-frontend.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your backend API URL
# Dev:  http://localhost:5000/api
# Prod: https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WhatsApp number (no + or spaces, include country code)
NEXT_PUBLIC_WHATSAPP=919129594282

# Razorpay publishable key (same as RAZORPAY_KEY_ID in backend)
NEXT_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxx
