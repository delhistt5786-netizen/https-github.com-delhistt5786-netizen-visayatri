{
  "manifest_version": 3,
  "name": "Visayatri Assistant",
  "version": "0.1.0",
  "description": "Maximum-safe form-fill assistance on configured official government visa portals. Never bypasses CAPTCHA, OTP, payment, or biometric steps.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://evisa.xuatnhapcanh.gov.vn/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://evisa.xuatnhapcanh.gov.vn/*"],
      "js": ["portal-mappings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
