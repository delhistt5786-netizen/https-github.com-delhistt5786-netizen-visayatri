{
  "manifest_version": 3,
  "name": "Visayatri Assistant",
  "version": "0.2.0",
  "description": "Maximum-safe form-fill assistance on configured official government visa portals. Never bypasses CAPTCHA, OTP, payment, or biometric steps.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://evisa.xuatnhapcanh.gov.vn/*",
    "https://evisa.rop.gov.om/*",
    "https://hayya.qa/*",
    "https://www.evisa.gov.bh/*",
    "https://visa.visitsaudi.com/*",
    "https://evisa.kdmid.ru/*",
    "https://evisa.imigrasi.go.id/*",
    "https://www.evisa.gov.kh/*",
    "https://www.thaievisa.go.th/*",
    "https://tdac.immigration.go.th/*",
    "https://malaysiavisa.imi.gov.my/*",
    "https://imigresen-online.imi.gov.my/*",
    "https://www.immd.gov.hk/*",
    "https://www.evisa.e-gov.kg/*",
    "https://www.evisa.tj/*",
    "https://e-visa.gov.uz/*",
    "https://eta.gov.lk/*",
    "https://www.evisa.gov.mn/*",
    "https://laoevisa.gov.la/*",
    "https://evisa.mfa.am/*",
    "https://evisa.gov.az/*",
    "https://evisa.mfa.gov.ua/*",
    "https://evisa.ica.gov.pg/*",
    "https://visa2egypt.gov.eg/*",
    "https://evis.ma/*",
    "https://www.evisa.gov.et/*",
    "https://visas.immigration.go.ug/*",
    "https://www.evisa.gov.zw/*",
    "https://etakenya.go.ke/*",
    "https://eservices.immigration.go.tz/*",
    "https://eta.dha.gov.za/*",
    "https://eservices.zambiaimmigration.gov.zm/*",
    "https://evisamada.gov.mg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://evisa.xuatnhapcanh.gov.vn/*",
        "https://evisa.rop.gov.om/*",
        "https://hayya.qa/*",
        "https://www.evisa.gov.bh/*",
        "https://visa.visitsaudi.com/*",
        "https://evisa.kdmid.ru/*",
        "https://evisa.imigrasi.go.id/*",
        "https://www.evisa.gov.kh/*",
        "https://www.thaievisa.go.th/*",
        "https://tdac.immigration.go.th/*",
        "https://malaysiavisa.imi.gov.my/*",
        "https://imigresen-online.imi.gov.my/*",
        "https://www.immd.gov.hk/*",
        "https://www.evisa.e-gov.kg/*",
        "https://www.evisa.tj/*",
        "https://e-visa.gov.uz/*",
        "https://eta.gov.lk/*",
        "https://www.evisa.gov.mn/*",
        "https://laoevisa.gov.la/*",
        "https://evisa.mfa.am/*",
        "https://evisa.gov.az/*",
        "https://evisa.mfa.gov.ua/*",
        "https://evisa.ica.gov.pg/*",
        "https://visa2egypt.gov.eg/*",
        "https://evis.ma/*",
        "https://www.evisa.gov.et/*",
        "https://visas.immigration.go.ug/*",
        "https://www.evisa.gov.zw/*",
        "https://etakenya.go.ke/*",
        "https://eservices.immigration.go.tz/*",
        "https://eta.dha.gov.za/*",
        "https://eservices.zambiaimmigration.gov.zm/*",
        "https://evisamada.gov.mg/*"
      ],
      "js": ["portal-mappings.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
